# Public canonical origin, with no trailing path.
APP_URL=https://shop.example.com

# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Local libSQL/SQLite: use an absolute persistent, backed-up volume path.
DATABASE_URL=file:/var/lib/bafkhaneh/production.db
# Or remote libSQL/Turso (then also set DATABASE_AUTH_TOKEN):
# DATABASE_URL=libsql://database-name.turso.io
# DATABASE_AUTH_TOKEN=

# Required for multi-instance/serverless production rate limiting.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Only for a single persistent Node process. Do not set with multiple replicas.
# RATE_LIMIT_ALLOW_MEMORY=true

# Operator-owned webhook: POST { "to": "09...", "message": "..." }.
SMS_WEBHOOK_URL=https://sms-gateway.example.com/send
SMS_WEBHOOK_TOKEN=

# Optional, local development only. Never enables fake payments in production.
# ENABLE_SIMULATED_PAYMENTS=true
# DEV_EXPOSE_RESET_CODE=true

# Optional one-time bootstrap values for `npm run db:seed`.
# SEED_ADMIN_PHONE=09xxxxxxxxx
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
